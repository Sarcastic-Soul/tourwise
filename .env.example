# Qloo hackathon key (arrives by email). Base URL is fixed for hackathon keys.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
# Max live Qloo calls per day for the whole app (cache hits are free).
QLOO_DAILY_CAP=300

# Neon Postgres (added later through the Vercel Marketplace)
